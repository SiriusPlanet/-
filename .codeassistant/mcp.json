{
  "mcpServers": {
    "sourcecraft": {
      "type": "streamable-http",
      "url": "https://api.sourcecraft.tech/mcp",
      "enabledTools": [
        "ListIssuesAssignedToAuthenticatedUser",
        "ListRepositoryIssues",
        "CreateIssue",
        "GetIssue",
        "DeleteIssue",
        "UpdateIssue",
        "CreateIssueComment",
        "GetIssueComment",
        "DeleteIssueComment",
        "UpdateIssueComment",
        "CreateLabel",
        "DeleteLabel",
        "GetLabels",
        "RemoveLabels",
        "AddLinkedPRs",
        "GetLinkedPRs",
        "RemoveLinkedPRs",
        "ListMyPullRequests",
        "ListRepositoryPullRequests",
        "CreatePullRequest",
        "GetPullRequest",
        "UpdatePullRequest",
        "DiscardPullRequest",
        "PublishPullRequest",
        "SetDecision",
        "MergePullRequest",
        "GetMergeChecks",
        "ListPullRequestComments",
        "ListPullRequestFiles",
        "CreatePullRequestComment",
        "GetPullRequestComment",
        "DeletePullRequestComment",
        "UpdatePullRequestComment",
        "RunWorkflows",
        "ListRuns",
        "GetRun",
        "GetWorkflow",
        "GetCubeArtifacts",
        "GetCubeLogs"
      ]
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "disabledTools": [],
      "alwaysAllow": [
        "create_entities",
        "create_relations",
        "add_observations",
        "delete_entities",
        "delete_observations",
        "delete_relations",
        "read_graph",
        "search_nodes",
        "open_nodes"
      ]
    }
  }
}